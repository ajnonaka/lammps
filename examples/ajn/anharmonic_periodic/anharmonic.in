# LAMMPS input script for a 1D anharmonic chain

# --- 1. Initialization ---
units           lj          # Use Lennard-Jones units (mass=1, distance=1, energy=1)
dimension       3           # We simulate a 1D chain in 3D space
boundary        s s p       # Shrink-wrapped in x and y (box boundaries expand/shrink to contain atoms in that direction), periodic in z (the chain direction)
atom_style      bond        # We have atoms connected by bonds

# --- 2. System Definition ---
read_data       data.chain  # Loads atom coordinates, bonds, and box dimensions from data.chain file

# --- 3. Force Field Definition ---
# Define the potential for the bonds between atoms.
bond_style      anharmonic
bond_coeff      1 0.5 0.3333333333 0.25 1.0   # bond type 1: K, KK, KKK (coefficients), r0=1.0 (equilibrium length)

# --- 4. Settings ---
# Set the timestep for the integration algorithm
timestep        0.0002

# Set up a file to dump atom coordinates for visualization
# exports atomic coordinates every 100 0timesteps to a file for later analysis or visualization

# Every 10,000 timesteps, write a snapshot of all atoms to the file dump.chain.lammpstrj for trajectory visualization/analysis.
# id (atom index), type (atom type), position x,y,z, velocity vx,vy,vz, force fx,fy,fz
dump            1 all custom 10000 dump.chain.lammpstrj id type x y z vx vy vz fx fy fz

# --- 5. Run Simulation ---

# Define groups of atoms
# Creates a group first_atom containing atoms with IDs 1 through 9.
group           first_atom id 1 2 3 4 5 6 7 8 9
# Creates a group last_atom containing just atom ID 10.
group           last_atom id 10

# Assign initial velocities to all atoms:
# Target temperature = 0.5 LJ units
# Random seed = 123456 for reproducibility
# Velocity distribution = Gaussian
# mom yes = remove net linear momentum after assignment
# rot yes = remove net angular momentum
# units box = velocities compatible with box dimensions in LJ units.
velocity         all create 0.5 123456 dist gaussian mom yes rot yes units box

# Overrides velocity for all atoms:
# Sets vx=0.0, vy=0.0, vz​ unchanged (NULL means don't change).
# sum no = don’t adjust velocities to maintain total momentum.
# This effectively kills motion in x and y, leaving only possible z-component velocities.
velocity         all set 0.0 0.0 NULL sum no units box

# Computes temperature with center-of-mass motion subtracted.
# Useful when you want translational drift removed from temperature calculations.
compute          Tcom all temp/com
# Computes pressure using the above temperature Tcom, ensuring COM drift doesn’t affect pressure.
compute          Pcom all pressure Tcom

# Applies Nose–Hoover NPT (constant Number, Pressure, Temperature) integration:
# Control temperature: T=0.5T=0.5 target and setpoint
# Temperature damping parameter = 100.0*dt
# Control pressure in z-direction only (anisotropic barostat):
# Target Pz=1.0Pz​=1.0
# Pressure damping = 1000.0*dt
# The box size in z will adjust to maintain pressure; x and y are shrink-wrapped so not controlled.

# Run the simulation using the NVE (microcanonical) ensemble
# This conserves energy, so the total energy should remain constant
# also conserves the number of atoms and volume throughout the simulation.
fix              1 all npt temp 0.5 0.5 $(100.0*dt) z 1.0 1.0 $(1000.0*dt)

# Modifies fix 1 (the NPT fix) to use Tcom and Pcom instead of the default temperature and pressure computes.
fix_modify       1 temp Tcom press Pcom

# Print thermodynamic info every 10,000 timesteps.
# Customize thermo output
# step = timestep number
# temp = default temperature
# pe = potential energy
# ke = kinetic energy
# etotal = total energy
# press = default pressure
# c_Tcom = temperature without COM drift
# c_Pcom = pressure without COM drift.
thermo          10000
thermo_style    custom step temp pe ke etotal press c_Tcom c_Pcom

# Run the simulation for this many steps
run             100000000

print           "Simulation finished."
